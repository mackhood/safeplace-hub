# ═══════════════════════════════════════════════════════════════
# SafePlace BLE Gateway — Configuración
# Copiá este archivo como .env y editá los valores
# ═══════════════════════════════════════════════════════════════

# URL del backend (dejar vacío hasta tener el backend listo)
BACKEND_URL=

# Endpoint de heart rate
REPORT_ENDPOINT=/api/heartrate

# Bearer token (dejar vacío si no se usa)
API_KEY=

# MACs de los wearables separadas por coma (vacío = auto-scan)
TARGET_ADDRESSES=

# Segundos entre cada guardado/reporte
REPORT_INTERVAL=5

# Timeout del scan BLE en segundos
SCAN_TIMEOUT=10

# Segundos antes de reintentar conexión BLE
RECONNECT_DELAY=5

# TTL del buffer de reenvío al backend (segundos)
BUFFER_TTL=7200

# Path de la base SQLite
DB_PATH=/home/USER/safeplace-gateway/safeplace.db

# Readings por batch en el flush al backend
FLUSH_BATCH_SIZE=50

# Path del archivo de log
LOG_FILE_PATH=/home/USER/safeplace-gateway/logger.txt

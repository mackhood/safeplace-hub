# ═══════════════════════════════════════════════════════════════
# SafePlace BLE Gateway — Configuración
# Copiá este archivo como .env y editá los valores
# ═══════════════════════════════════════════════════════════════

# URL BASE del backend real de SafePlace, sin path (dejar vacío hasta tener
# el backend listo). Ej: http://192.168.1.10:8000 o https://tu-backend.onrender.com
# Los paths de la API (/api/v1/mediciones, /api/v1/dispositivos/...) son
# fijos, no se configuran acá.
BACKEND_URL=

# Debe coincidir EXACTO con GATEWAY_API_KEY del backend — se manda en el
# header x-device-api-key, el mismo mecanismo que usa el resto del sistema
# para autenticar al gateway (no es un Bearer token).
API_KEY=

# MACs de los wearables separadas por coma (vacío = auto-scan)
TARGET_ADDRESSES=

# Segundos entre cada guardado/reporte
REPORT_INTERVAL=5

# Timeout del scan BLE en segundos
SCAN_TIMEOUT=10

# Segundos antes de reintentar conexión BLE
RECONNECT_DELAY=5

# TTL del buffer de reenvío al backend (segundos)
BUFFER_TTL=7200

# Path de la base SQLite
DB_PATH=/home/USER/safeplace-gateway/safeplace.db

# Readings por batch en el flush al backend
FLUSH_BATCH_SIZE=50

# ── Nivel de actividad (proxy derivado de FC, ADR-14) ──────────────
# hr-proxy = estima nivelActividad a partir de la variación de la FC
# fixed    = valor constante (ACTIVITY_FIXED_VALUE) — para tests/demos
# off      = no manda nivelActividad
# NOTA: el hub SIEMPRE debe enviar el campo (hr-proxy o fixed). Con `off` el
# backend guarda NULL y la columna ACTIVIDAD queda en "--". Para demos usar
# fixed + ACTIVITY_FIXED_VALUE=0.5 (señal determinista, etiqueta "Media").
ACTIVITY_MODE=hr-proxy
ACTIVITY_FIXED_VALUE=0.5
ACTIVITY_PROXY_WINDOW=6
ACTIVITY_MOVEMENT_FLOOR=0.08
RESTING_HR=65

# ── Detección de "wearable congelado" (CP-E2E-04) ─────────────────
# N lecturas seguidas con la misma pulsación exacta => se reporta
# DESCONECTADO (a REPORT_INTERVAL=5s, 12 ≈ 1 minuto).
STUCK_READINGS_THRESHOLD=12

# Path del archivo de log
LOG_FILE_PATH=/home/USER/safeplace-gateway/logger.txt
